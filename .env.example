# Add these in Vercel: Project > Settings > Environment Variables, then redeploy.

# --- Storage (added automatically when you connect "Upstash for Redis" in the Storage tab) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- AI model (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=

# --- The Erecta brand's own WhatsApp Business number (Meta WhatsApp Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=make-up-a-password
WHATSAPP_APP_SECRET=
# The number patients message, digits only with country code. Used by the CTA button and QR code.
WHATSAPP_DISPLAY_NUMBER=

# --- Drug safety ---
# Password for /api/reports (side-effect reports and requests for a person)
ADMIN_KEY=make-up-a-long-password
# Optional: also send each side-effect report to this address (n8n, Make, Zapier, Teams/Slack workflow)
SAFETY_WEBHOOK_URL=

# Optional
BRAND_TEAM_NAME=Erecta patient support
ENABLE_WEB_CHAT=true
WHATSAPP_API_BASE=
WHATSAPP_GRAPH_VERSION=v24.0
